# 이 파일을 복사해 .env를 만들고 값은 팀장에게 개인 메시지로 받으세요. .env는 절대 커밋하지 않습니다.

# ── 서버 전용 비밀 값 (api/, scripts/에서만 씀. 브라우저 코드나 VITE_ 변수에 절대 넣지 않음) ──
CLOVA_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── 브라우저에 공개되는 값 (VITE_로 시작. 공개돼도 되는 값만) ──
# 로그인 방식: mock(기본, 메일 안 보냄) | real(Supabase 학교 이메일 인증 코드)
VITE_AUTH_MODE=mock
# 진행 저장 방식: mock(기본, 새로고침하면 초기화) | real(서버 api/progress 등. 서버가 생기기 전에는 mock 유지)
# 로그인만 먼저 시험하려면 VITE_AUTH_MODE=real + VITE_PROGRESS_MODE=mock.
# VITE_AUTH_MODE=mock인데 VITE_PROGRESS_MODE=real이면 진짜 토큰이 없어 콘솔에 경고하고 진행 저장도 mock으로 동작합니다.
VITE_PROGRESS_MODE=mock
# VITE_AUTH_MODE=real일 때만 필요. Supabase 대시보드 → Project Settings → API의 Project URL과 Publishable(anon) 키
# Secret 키(sb_secret_…)는 절대 넣지 않습니다. 설정 방법: docs/AUTH_SETUP.md
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
